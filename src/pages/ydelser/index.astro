---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../data/company';
import { services } from '../../data/services';
import '../../styles/nordic-shine.css';
import '../../styles/nordic-shine-service.css';

const title = 'Bilpleje og klargøring i Esbjerg | Esbjerg Shine';
const description = 'Se ydelser inden for bilvask, indvendig bilpleje, klargøring, polering, lakbeskyttelse og sæderens hos Esbjerg Shine i Esbjerg.';
---
<BaseLayout title={title} description={description} canonicalPath="/ydelser/">
  <div class="ns-site ns-services-page" data-ns-site id="top">
    <div class="ns-topbar"><div class="ns-wrap ns-topbar__inner"><span>Bilpleje i Esbjerg · Efter aftale</span><div><a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{company.address.street}, {company.address.postalCode} {company.address.city}</a><a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></div></div></div>
    <header class="ns-header" data-ns-header><div class="ns-wrap ns-header__inner"><a class="ns-brand" href="/"><span class="ns-brand__mark">ES</span><span class="ns-brand__text"><strong>ESBJERG SHINE</strong><small>Detaljer der skinner.</small></span></a><nav class="ns-nav" aria-label="Primær navigation"><a href="/#ydelser">Ydelser</a><a href="/#resultater">Før / efter</a><a href="/#om">Om os</a><a href="/#kontakt">Kontakt</a></nav><a class="ns-header__cta" href="/#kontakt">Få et tilbud</a></div></header>

    <main id="indhold">
      <section class="nss-hero">
        <div class="ns-wrap nss-hero__grid">
          <div class="nss-hero__copy ns-reveal"><p class="ns-eyebrow">YDELSER</p><h1>Den rigtige behandling starter med bilen.</h1><p>Ingen biler er helt ens. Derfor vælger vi behandling efter stand, materialer og det resultat, du ønsker — ikke efter en fast pakke.</p></div>
          <div class="nss-hero__media ns-reveal"><div class="nss-photo"><span>ESBJERG SHINE</span><small>Vask · kabine · polering · beskyttelse</small><b>06 YDELSER</b></div></div>
        </div>
      </section>

      <section class="ns-services">
        <div class="ns-wrap">
          <div class="ns-service-grid">
            {services.map((service, index) => (
              <article class={`ns-service ns-service--${service.slug} ns-reveal`}>
                <a href={`/ydelser/${service.slug}/`} data-wiper-link data-service-name={service.title}>
                  <div class="ns-service__media" aria-hidden="true"><div class="ns-service__texture"></div><span>0{index + 1}</span></div>
                  <div class="ns-service__body"><small>{service.eyebrow}</small><h2>{service.title}</h2><p>{service.summary}</p><span class="ns-service__link">Se ydelsen <b>↗</b></span></div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ns-values">
        <div class="ns-wrap ns-values__grid">
          <div class="ns-values__intro ns-reveal"><p class="ns-eyebrow">I TVIVL?</p><h2>Beskriv bilen. Så finder vi næste skridt.</h2></div>
          <div class="ns-values__items"><article class="ns-reveal"><span>01</span><h3>Send en besked</h3><p>Bilmodel, stand og hvad du vil have forbedret.</p></article><article class="ns-reveal"><span>02</span><h3>Vi vurderer behovet</h3><p>Du behøver ikke vælge behandling på forhånd.</p></article><article class="ns-reveal"><span>03</span><h3>Du får et konkret næste skridt</h3><p>Ring eller brug kontaktformularen på forsiden.</p></article></div>
        </div>
      </section>
    </main>

    <footer class="ns-footer"><div class="ns-wrap ns-footer__main"><a class="ns-brand ns-brand--footer" href="/"><span class="ns-brand__mark">ES</span><span class="ns-brand__text"><strong>ESBJERG SHINE</strong><small>Detaljer der skinner.</small></span></a><div class="ns-footer__nav"><a href="/#ydelser">Ydelser</a><a href="/#kontakt">Kontakt</a><a href="/privatliv/">Privatliv</a></div></div><div class="ns-wrap ns-footer__bottom"><span>{company.address.street}, {company.address.postalCode} {company.address.city}</span><span>CVR {company.cvr}</span></div></footer>

    <div class="ns-wiper" data-wiper-transition aria-hidden="true"><canvas data-wiper-canvas></canvas><div class="ns-wiper__blade" data-wiper-arm><i></i></div></div>
  </div>
  <script is:inline src="/nordic-shine.js" defer></script>
</BaseLayout>
