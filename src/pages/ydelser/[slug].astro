---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MediaImage from '../../components/MediaImage.astro';
import { services, type Service } from '../../data/services';
import { getServiceMedia } from '../../data/media';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const serviceMedia = getServiceMedia(service.slug);
const canonicalPath = `/ydelser/${service.slug}/`;
const site = Astro.site ?? new URL('https://esbjergshine.dk');
const home = site.toString().replace(/\/$/, '');
const pageUrl = `${home}${canonicalPath}`;
const hasDetailImage = existsSync(join(process.cwd(), 'public', serviceMedia.detail.replace(/^\//, '')));

const schema = [
  {
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: service.title,
    serviceType: service.title,
    description: service.seoDescription,
    url: pageUrl,
    ...(hasDetailImage ? { image: `${home}${serviceMedia.detail}` } : {}),
    areaServed: { '@type': 'City', name: 'Esbjerg' },
    provider: { '@id': `${home}/#virksomhed` },
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` }
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Forside', item: `${home}/` },
      { '@type': 'ListItem', position: 2, name: 'Ydelser', item: `${home}/ydelser/` },
      { '@type': 'ListItem', position: 3, name: service.title }
    ]
  }
];
---
<BaseLayout title={service.seoTitle} description={service.seoDescription} canonicalPath={canonicalPath} schema={schema}>
  <div id="top"></div>
  <Header />
  <main id="indhold">
    <section class="subhero subhero--service">
      <div class="shell">
        <nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/">Forside</a><span aria-hidden="true">/</span><a href="/ydelser/">Ydelser</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span></nav>
        <div class="subhero__grid">
          <div><p class="eyebrow">{service.eyebrow}</p><h1>{service.title}</h1></div>
          <p>{service.intro}</p>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="shell service-detail">
        <article class="service-detail__content">
          <MediaImage class="service-detail__visual" src={serviceMedia.detail} alt={`${service.title} hos Esbjerg Shine i Esbjerg`} width={1920} height={1080} />
          <h2>{service.detailTitle}</h2>
          <p>{service.detailText}</p>
          {service.notice && <ul class="detail-list" aria-label="Vigtigt"><li><strong>Vigtigt:</strong> {service.notice}</li></ul>}
          <h2>Det har vi typisk fokus på</h2>
          <ul class="detail-list">{service.bullets.map((item) => <li>{item}</li>)}</ul>
          <h2>Få en vurdering af din bil</h2>
          <p>Send gerne bilmodel, et par billeder og en kort beskrivelse af, hvad du gerne vil have lavet. Så kan vi vurdere opgaven og vende tilbage med et tilbud, der passer til bilen.</p>
        </article>
        <aside class="service-aside">
          <div class="aside-card"><small>Få et tilbud</small><h2>Skal vi se på din bil?</h2><p>Fortæl kort, hvad du ønsker, så vender vi tilbage.</p><a class="button button--primary" href={`/?service=${encodeURIComponent(service.title)}#kontakt`}><span>Kontakt os</span><i aria-hidden="true">↗</i></a></div>
          <nav class="aside-nav" aria-label="Andre ydelser"><small>Andre ydelser</small>{services.map((item) => <a class:list={{ active: item.slug === service.slug }} aria-current={item.slug === service.slug ? 'page' : undefined} href={`/ydelser/${item.slug}/`}>{item.title}<span aria-hidden="true">→</span></a>)}</nav>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
