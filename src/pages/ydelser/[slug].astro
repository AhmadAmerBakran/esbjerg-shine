---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../data/company';
import { services, type Service } from '../../data/services';
import '../../styles/auxo-refined.css';
import '../../styles/auxo-refined-service.css';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const canonicalPath = `/ydelser/${service.slug}/`;
const site = Astro.site ?? new URL('https://esbjergshine.dk');
const home = site.toString().replace(/\/$/, '');
const index = services.findIndex((item) => item.slug === service.slug);
const number = String(index + 1).padStart(2, '0');

const schema = [
  {
    '@type': 'Service',
    '@id': `${home}${canonicalPath}#service`,
    name: service.title,
    serviceType: service.title,
    url: `${home}${canonicalPath}`,
    areaServed: { '@type': 'City', name: 'Esbjerg' },
    provider: { '@id': `${home}/#virksomhed` }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Forside', item: `${home}/` },
      { '@type': 'ListItem', position: 2, name: 'Ydelser', item: `${home}/#ydelser` },
      { '@type': 'ListItem', position: 3, name: service.title, item: `${home}${canonicalPath}` }
    ]
  }
];
---
<BaseLayout title={service.seoTitle} description={service.seoDescription} canonicalPath={canonicalPath} schema={schema}>
  <div class={`refined-site refined-service-page refined-service-page--${service.slug}`} data-refined-site id="top">
    <div class="refined-topbar">
      <div class="refined-shell refined-topbar__inner"><span>{company.address.street}, {company.address.postalCode} {company.address.city}</span><div><span>{company.openingText}</span><a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></div></div>
    </div>
    <header class="refined-header" data-refined-header>
      <div class="refined-shell refined-header__inner">
        <a class="refined-brand" href="/" aria-label="Esbjerg Shine – forside"><span class="refined-brand__mark">ES</span><span><strong>ESBJERG SHINE</strong><small>DETALJER DER SKINNER.</small></span></a>
        <nav class="refined-nav" aria-label="Primær navigation"><a href="/#ydelser">Ydelser</a><a href="/#om">Om os</a><a href="/#resultater">Før / efter</a><a href="/#kontakt">Kontakt</a></nav>
        <a class="refined-header__cta" href={`/?service=${encodeURIComponent(service.title)}#kontakt`}>Få et tilbud <span>↗</span></a>
      </div>
    </header>

    <main id="indhold">
      <section class="refined-service-hero">
        <div class="refined-shell refined-service-hero__grid">
          <div class="refined-service-hero__copy refined-reveal">
            <nav class="refined-service-crumbs" aria-label="Brødkrummer"><a href="/">Forside</a><span>/</span><a href="/#ydelser">Ydelser</a><span>/</span><b>{number}</b></nav>
            <p class="refined-kicker">{service.eyebrow}</p>
            <h1>{service.title}</h1>
            <p>{service.intro}</p>
            <div class="refined-service-hero__actions"><a class="refined-button refined-button--primary" href={`/?service=${encodeURIComponent(service.title)}#kontakt`}>Få et tilbud <span>↗</span></a><a class="refined-button refined-button--ghost" href={`tel:${company.phoneHref}`}>Ring direkte <span>↗</span></a></div>
          </div>
          <div class="refined-service-hero__visual refined-reveal">
            <div class="refined-service-hero__image"><img src="/hero-detailing-car.svg" width="1200" height="720" alt="" aria-hidden="true" decoding="async" /><span></span><b>{number}</b></div>
          </div>
        </div>
      </section>

      <section class="refined-service-content">
        <div class="refined-shell refined-service-content__grid">
          <article class="refined-service-copy refined-reveal">
            <p class="refined-kicker">BEHANDLINGEN</p>
            <h2>Tilpasset bilen.<br />Ikke en standardpakke.</h2>
            <p>{service.intro}</p>
            <p>Inden arbejdet går i gang, afstemmer vi forventningerne og ser på bilens aktuelle stand. Det gør det lettere at vælge den behandling, der giver mening, frem for at sælge mere end bilen behøver.</p>
            <div class="refined-service-photo"><span>Projektfoto indsættes her</span></div>
          </article>
          <aside class="refined-service-aside refined-reveal">
            <div class="refined-service-focus"><small>TYPISK FOKUS</small><ul>{service.bullets.map((item, bulletIndex) => <li><span>0{bulletIndex + 1}</span><strong>{item}</strong></li>)}</ul></div>
            <div class="refined-service-quick"><small>ESBJERG SHINE</small><strong>Skal vi se på din bil?</strong><p>Send bilmodel, billeder og en kort beskrivelse af det ønskede resultat.</p><a href={`/?service=${encodeURIComponent(service.title)}#kontakt`}>Kontakt os <span>↗</span></a></div>
          </aside>
        </div>
      </section>

      <section class="refined-service-related">
        <div class="refined-shell">
          <header class="refined-section-head refined-reveal"><div><p class="refined-kicker">ANDRE YDELSER</p><h2>Måske har bilen<br />brug for mere.</h2></div><p>Se de øvrige behandlinger, eller kontakt os hvis du er i tvivl om hvad der passer til bilen.</p></header>
          <div class="refined-related-grid">
            {services.map((item, itemIndex) => item.slug !== service.slug && (
              <a class="refined-related-link refined-reveal" href={`/ydelser/${item.slug}/`} data-wiper-link data-service-name={item.title}>
                <span>0{itemIndex + 1}</span><strong>{item.title}</strong><small>{item.eyebrow}</small><i>↗</i>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="refined-footer"><div class="refined-shell refined-footer__top"><a class="refined-brand" href="/"><span class="refined-brand__mark">ES</span><span><strong>ESBJERG SHINE</strong><small>DETALJER DER SKINNER.</small></span></a><div class="refined-footer__nav"><a href="/#ydelser">Ydelser</a><a href="/#kontakt">Kontakt</a><a href="/privatliv/">Privatliv</a></div></div><div class="refined-shell refined-footer__bottom"><span>{company.address.street}, {company.address.postalCode} {company.address.city}</span><span>CVR {company.cvr}</span></div></footer>

    <div class="wiper-transition" data-wiper-transition aria-hidden="true"><canvas data-wiper-canvas></canvas><div class="wiper-transition__label"><span data-wiper-label>BEHANDLING</span><i></i></div><div class="wiper-arm" data-wiper-arm><i></i><b></b></div></div>
  </div>
  <script is:inline src="/auxo-refined.js" defer></script>
</BaseLayout>
