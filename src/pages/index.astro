---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import ContactForm from '../components/ContactForm.astro';
import { company } from '../data/company';
import { services } from '../data/services';
import '../styles/rainline.css';

const title = 'Bilpleje i Esbjerg | Esbjerg Shine';
const description = 'Esbjerg Shine tilbyder bilpleje, klargøring, polering, håndvask og lakbeskyttelse i Esbjerg. Kontakt os og få et tilbud tilpasset din bil.';

const serviceSchema = {
  '@type': 'ItemList',
  name: 'Bilpleje hos Esbjerg Shine',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      url: new URL(`/ydelser/${service.slug}/`, Astro.site ?? 'https://esbjergshine.dk').toString(),
      provider: { '@id': `${(Astro.site ?? new URL('https://esbjergshine.dk')).toString().replace(/\/$/, '')}/#virksomhed` }
    }
  }))
};

const materialNames: Record<string, string> = {
  'bilvask': 'WATER / CONTACT',
  'indvendig-bilpleje': 'CABIN / MATERIAL',
  'komplet-klargoering': 'FULL / RESET',
  'polering': 'PAINT / CORRECTION',
  'lakbeskyttelse': 'COAT / PROTECT',
  'saederens': 'TEXTILE / EXTRACTION'
};
---
<BaseLayout title={title} description={description} schema={serviceSchema}>
  <div class="rainline-site" id="top" data-rainline-site>
    <header class="rainline-nav" data-rainline-nav>
      <a class="rainline-brand" href="#top" aria-label="Esbjerg Shine – forside">
        <span class="rainline-brand__monogram">ES</span>
        <span class="rainline-brand__copy"><strong>ESBJERG SHINE</strong><small>DETAILING · ESBJERG</small></span>
      </a>
      <nav class="rainline-menu" aria-label="Primær navigation">
        <a href="#ydelser">Ydelser</a>
        <a href="#resultater">Resultater</a>
        <a href="#metode">Metode</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <a class="rainline-phone" href={`tel:${company.phoneHref}`}>{company.phoneDisplay}<span aria-hidden="true">↗</span></a>
    </header>

    <main id="indhold">
      <section class="rainline-hero" aria-labelledby="rainline-title">
        <div class="rainline-hero__rule" aria-hidden="true"></div>
        <div class="rainline-shell rainline-hero__grid">
          <div class="rainline-hero__copy rl-reveal">
            <p class="rl-kicker">ESBJERG · DETAILING · EFTER AFTALE</p>
            <h1 id="rainline-title">Finish du kan<br /><em>se i lyset.</em></h1>
            <p class="rainline-hero__lead">Håndvask, polering, kabinepleje og lakbeskyttelse udført med ro, præcision og respekt for materialerne.</p>
            <div class="rainline-actions">
              <a class="rl-action rl-action--light" href="#ydelser">Se behandlinger <span>↓</span></a>
              <a class="rl-action" href="#kontakt">Få et tilbud <span>↗</span></a>
            </div>
            <dl class="rainline-hero__facts">
              <div><dt>Studio</dt><dd>Randersvej 26</dd></div>
              <div><dt>Åbning</dt><dd>Efter aftale</dd></div>
              <div><dt>Fokus</dt><dd>Lak · Kabine · Finish</dd></div>
            </dl>
          </div>

          <div class="windshield-piece rl-reveal" data-windshield-piece aria-label="Abstrakt detalje inspireret af vådt bilglas og blank lak">
            <div class="windshield-piece__glass">
              <div class="windshield-piece__rain" aria-hidden="true">
                {Array.from({ length: 18 }).map((_, index) => <i style={`--i:${index}`}></i>)}
              </div>
              <div class="windshield-piece__reflection" aria-hidden="true"></div>
              <div class="windshield-piece__cut" aria-hidden="true"></div>
              <div class="windshield-piece__hood" aria-hidden="true"><i></i><b></b></div>
              <div class="windshield-piece__light-signature" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="windshield-piece__caption"><span>GLASS / PAINT / LIGHT</span><strong>Controlled surface. Clean reflection.</strong></div>
            </div>
            <div class="windshield-piece__scale" aria-hidden="true"><span>01</span><i></i><span>06</span></div>
          </div>
        </div>

        <div class="rainline-hero__foot" aria-hidden="true"><span>DETAILING STUDIO / 6700 ESBJERG</span><i></i><span>SCROLL TO INSPECT</span></div>
      </section>

      <section class="rainline-intro" aria-label="Esbjerg Shine tilgang">
        <div class="rainline-shell rainline-intro__grid">
          <p class="rl-kicker rl-reveal">DETALJEN FØRST</p>
          <div class="rainline-intro__statement rl-reveal">
            <h2>Ikke show. Ikke støj.<br /><em>Bare overflader, der står skarpt.</em></h2>
            <p>En flot bil handler om flere materialer på én gang: lak, glas, plast, tekstil og læder. Derfor behandles hver del efter det, den faktisk har brug for.</p>
          </div>
          <div class="rainline-intro__mark rl-reveal" aria-hidden="true"><span>ES</span><small>DETAIL / CARE</small></div>
        </div>
      </section>

      <section class="rainline-services" id="ydelser" aria-labelledby="services-title">
        <div class="rainline-shell">
          <header class="rainline-services__head rl-reveal">
            <div><p class="rl-kicker">BEHANDLINGER / 06</p><h2 id="services-title">Vælg hvad bilen<br /><em>har brug for.</em></h2></div>
            <p>Hver behandling har sin egen materialelogik. Peg på en ydelse for at se den reagere; klik, og vinduesviskeren rydder siden før behandlingen åbner.</p>
          </header>

          <div class="service-index">
            {services.map((service, index) => (
              <article class={`service-index__row service-index__row--${service.slug} rl-reveal`} data-service-row>
                <a href={`/ydelser/${service.slug}/`} data-wiper-link data-service-name={service.title}>
                  <span class="service-index__no">0{index + 1}</span>
                  <div class="service-index__title"><small>{materialNames[service.slug] ?? 'DETAIL / CARE'}</small><h3>{service.title}</h3></div>
                  <p>{service.summary}</p>
                  <div class="service-index__sample" aria-hidden="true" data-service-sample><i></i><i></i><i></i><i></i></div>
                  <span class="service-index__open">Se ydelse <i>↗</i></span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="reflection-room" aria-labelledby="reflection-title" data-reflection-room>
        <div class="reflection-room__surface" aria-hidden="true">
          <div class="reflection-room__before"></div>
          <div class="reflection-room__after"></div>
          <div class="reflection-room__beam" data-reflection-beam></div>
          <div class="reflection-room__trace"></div>
        </div>
        <div class="rainline-shell reflection-room__content">
          <div class="reflection-room__copy rl-reveal">
            <p class="rl-kicker">INSPEKTIONSLYS</p>
            <h2 id="reflection-title">Lyset viser<br /><em>hvad lakken skjuler.</em></h2>
            <p>Bevæg markøren over overfladen. Den smalle lysstribe simulerer en kontrol under inspektionslys, hvor vaskespor og manglende dybde bliver tydeligere.</p>
          </div>
          <div class="reflection-room__legend rl-reveal"><span>ORIGINAL SURFACE</span><i></i><span>CORRECTED SURFACE</span></div>
        </div>
      </section>

      <section class="rainline-proof" id="resultater" aria-labelledby="proof-title">
        <div class="rainline-shell rainline-proof__grid">
          <div class="rainline-proof__copy rl-reveal">
            <p class="rl-kicker">FØR / EFTER</p>
            <h2 id="proof-title">Resultatet skal<br /><em>kunne kontrolleres.</em></h2>
            <p>Én ramme, flere projekter. Skift projekt med pilene og træk divideren for at sammenligne før og efter.</p>
            <div class="rainline-proof__note"><span>01</span><i></i><small>SAMME VINKEL · SAMME BIL · REEL FORSKEL</small></div>
          </div>
          <div class="rainline-proof__viewer rl-reveal"><BeforeAfterGallery /></div>
        </div>
      </section>

      <section class="rainline-method" id="metode" aria-labelledby="method-title">
        <div class="rainline-shell">
          <header class="rainline-method__head rl-reveal"><p class="rl-kicker">FORLØBET</p><h2 id="method-title">Fire rolige trin.<br /><em>Ingen unødige omveje.</em></h2></header>
          <ol class="rainline-method__list">
            <li class="rl-reveal"><span>01</span><strong>Fortæl om bilen</strong><p>Model, stand og hvad du ønsker forbedret.</p><i>CONTACT</i></li>
            <li class="rl-reveal"><span>02</span><strong>Vi vurderer behovet</strong><p>Behandlingen vælges efter bilen, ikke efter en fast pakke.</p><i>ASSESS</i></li>
            <li class="rl-reveal"><span>03</span><strong>Arbejdet udføres</strong><p>Vask, rens, korrektion eller beskyttelse med fokus på finish.</p><i>DETAIL</i></li>
            <li class="rl-reveal"><span>04</span><strong>Finishen kontrolleres</strong><p>Det samlede resultat gennemgås før aflevering.</p><i>DELIVER</i></li>
          </ol>
        </div>
      </section>

      <section class="rainline-profile" aria-labelledby="profile-title">
        <div class="rainline-shell rainline-profile__grid">
          <div class="rainline-profile__copy rl-reveal"><p class="rl-kicker">ESBJERG SHINE</p><h2 id="profile-title">Lokalt studio.<br /><em>Personlig behandling.</em></h2><p>Arbejdet foregår efter aftale på Randersvej i Esbjerg. Det giver plads til at tilpasse behandlingen til bilens faktiske stand og det ønskede resultat.</p></div>
          <dl class="rainline-profile__specs rl-reveal">
            <div><dt>Adresse</dt><dd><a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{company.address.street}<br />{company.address.postalCode} {company.address.city} ↗</a></dd></div>
            <div><dt>Åbning</dt><dd>{company.openingText}</dd></div>
            <div><dt>Telefon</dt><dd><a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></dd></div>
            <div><dt>CVR</dt><dd>{company.cvr}</dd></div>
          </dl>
        </div>
      </section>

      <section class="rainline-contact" id="kontakt" aria-labelledby="contact-title">
        <div class="rainline-shell rainline-contact__grid">
          <div class="rainline-contact__copy rl-reveal">
            <p class="rl-kicker">KONTAKT</p>
            <h2 id="contact-title">Hvad skal vi gøre<br /><em>ved din bil?</em></h2>
            <p>Beskriv bilen kort. Du behøver ikke vide på forhånd, hvilken behandling der er den rigtige.</p>
            <a class="rainline-contact__phone" href={`tel:${company.phoneHref}`}><small>RING DIREKTE</small><strong>{company.phoneDisplay}</strong></a>
            <div class="rainline-contact__social"><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={company.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a></div>
          </div>
          <div class="rainline-form rl-reveal"><div class="rainline-form__top"><span>ESBJERG SHINE / REQUEST</span><i>OPEN</i></div><ContactForm /></div>
        </div>
      </section>
    </main>

    <footer class="rainline-footer">
      <div class="rainline-shell rainline-footer__inner">
        <a class="rainline-brand" href="#top"><span class="rainline-brand__monogram">ES</span><span class="rainline-brand__copy"><strong>ESBJERG SHINE</strong><small>DETALJER DER SKINNER.</small></span></a>
        <p>{company.address.street}, {company.address.postalCode} {company.address.city} · CVR {company.cvr}</p>
        <div><a href="/privatliv/">Privatliv</a><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={company.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></div>
      </div>
    </footer>

    <div class="wiper-transition" data-wiper-transition aria-hidden="true">
      <canvas data-wiper-canvas></canvas>
      <div class="wiper-transition__label"><span data-wiper-label>BEHANDLING</span><i></i></div>
      <div class="wiper-arm" data-wiper-arm><i></i><b></b></div>
    </div>
  </div>
  <script is:inline src="/rainline.js" defer></script>
</BaseLayout>