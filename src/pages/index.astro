---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import ContactForm from '../components/ContactForm.astro';
import { company } from '../data/company';
import { services } from '../data/services';
import '../styles/surface-editorial.css';

const title = 'Bilpleje i Esbjerg | Esbjerg Shine';
const description = 'Esbjerg Shine tilbyder bilpleje, klargøring, polering, håndvask og lakbeskyttelse i Esbjerg. Kontakt os og få et tilbud tilpasset din bil.';

const serviceSchema = {
  '@type': 'ItemList',
  name: 'Bilpleje hos Esbjerg Shine',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      url: new URL(`/ydelser/${service.slug}/`, Astro.site ?? 'https://esbjergshine.dk').toString(),
      provider: { '@id': `${(Astro.site ?? new URL('https://esbjergshine.dk')).toString().replace(/\/$/, '')}/#virksomhed` }
    }
  }))
};
---
<BaseLayout title={title} description={description} schema={serviceSchema}>
  <div class="surface-site" id="top" data-surface-site>
    <header class="surface-nav" data-surface-nav>
      <a class="surface-brand" href="#top" aria-label="Esbjerg Shine – forside">
        <span class="surface-brand__badge">ES</span>
        <span><strong>ESBJERG SHINE</strong><small>DETAILING / ESBJERG</small></span>
      </a>
      <nav class="surface-menu" aria-label="Primær navigation">
        <a href="#ydelser">Ydelser</a>
        <a href="#inspektion">Lak</a>
        <a href="#resultater">Før / efter</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <a class="surface-call" href={`tel:${company.phoneHref}`}>{company.phoneDisplay}<span>↗</span></a>
    </header>

    <main id="indhold">
      <section class="surface-hero" aria-labelledby="surface-hero-title">
        <div class="surface-hero__grain" aria-hidden="true"></div>
        <div class="surface-shell surface-hero__layout">
          <div class="surface-hero__copy surface-reveal">
            <p class="surface-eyebrow">Bilpleje / Esbjerg / 6700</p>
            <h1 id="surface-hero-title">Det er ikke bilen.<br /><em>Det er overfladen.</em></h1>
            <p class="surface-hero__lead">Blank lak. Rene materialer. Skarpe refleksioner. Esbjerg Shine arbejder med de ting, du mærker og ser, når en bil føles rigtig.</p>
            <div class="surface-hero__actions">
              <a class="surface-button surface-button--dark" href="#ydelser"><span>Se behandlinger</span><i>↓</i></a>
              <a class="surface-button" href="#kontakt"><span>Få et tilbud</span><i>↗</i></a>
            </div>
          </div>

          <div class="material-object surface-reveal" data-material-object aria-label="Interaktiv visualisering af blank billak">
            <div class="material-object__frame">
              <div class="material-object__paint">
                <span class="material-object__ridge material-object__ridge--one"></span>
                <span class="material-object__ridge material-object__ridge--two"></span>
                <span class="material-object__ridge material-object__ridge--three"></span>
                <span class="material-object__light"></span>
                <span class="material-object__edge"></span>
              </div>
              <div class="material-object__drops" data-material-drops aria-hidden="true"></div>
              <div class="material-object__caption"><span>01 / PAINT</span><strong>Clearcoat under inspection</strong></div>
            </div>
            <div class="material-object__labels" aria-hidden="true">
              <span>GLOSS</span><span>DEPTH</span><span>REFLECTION</span>
            </div>
          </div>
        </div>

        <div class="surface-hero__footer" aria-hidden="true">
          <span>HÅNDVASK</span><i></i><span>POLERING</span><i></i><span>COATING</span><i></i><span>INTERIØR</span><i></i><span>TEKSTIL</span>
        </div>
      </section>

      <section class="surface-statement" aria-label="Esbjerg Shine tilgang">
        <div class="surface-shell surface-statement__grid">
          <span class="surface-statement__number surface-reveal">01</span>
          <h2 class="surface-reveal">En god finish er ikke pynt.<br /><em>Den afslører arbejdet.</em></h2>
          <p class="surface-reveal">Designet er bygget omkring det, detailing faktisk ændrer: lak, glas, fælge, tekstil, plast og læder. Ikke omkring et virtuelt værksted eller en kunstig show-car.</p>
        </div>
      </section>

      <section class="care-atlas" id="ydelser" aria-labelledby="atlas-title">
        <div class="surface-shell">
          <header class="care-atlas__head surface-reveal">
            <div>
              <p class="surface-eyebrow">Care atlas / 06 behandlinger</p>
              <h2 id="atlas-title">Hver behandling<br /><em>har sit materiale.</em></h2>
            </div>
            <p>Hold musen over en behandling. Vand, læder, lak, coating og tekstil reagerer forskelligt, så hver ydelse får sit eget fysiske udtryk.</p>
          </header>

          <div class="care-atlas__list">
            {services.map((service, index) => (
              <article class={`care-row care-row--${service.slug} surface-reveal`} data-care-row>
                <a href={`/ydelser/${service.slug}/`} data-finish-link>
                  <span class="care-row__index">0{index + 1}</span>
                  <div class="care-row__copy">
                    <small>{service.eyebrow}</small>
                    <h3>{service.title}</h3>
                    <p>{service.summary}</p>
                  </div>
                  <div class="care-row__material" data-care-material aria-hidden="true">
                    <i class="care-row__layer care-row__layer--a"></i>
                    <i class="care-row__layer care-row__layer--b"></i>
                    <i class="care-row__layer care-row__layer--c"></i>
                  </div>
                  <span class="care-row__arrow">↗</span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="inspection" id="inspektion" aria-labelledby="inspection-title" data-inspection>
        <div class="inspection__panel" data-inspection-panel aria-hidden="true">
          <div class="inspection__paint"></div>
          <div class="inspection__defects"></div>
          <div class="inspection__corrected"></div>
          <div class="inspection__lamp"></div>
          <div class="inspection__cursor"><span></span></div>
        </div>
        <div class="surface-shell inspection__content">
          <div class="inspection__copy surface-reveal">
            <p class="surface-eyebrow">Paint inspection</p>
            <h2 id="inspection-title">Flyt lyset.<br /><em>Se forskellen.</em></h2>
            <p>Vaskespor og små lakdefekter gemmer sig i normalt lys. Under en skarp inspektionslampe bliver overfladen ærlig. Bevæg markøren over panelet for at simulere, hvordan lakken vurderes.</p>
          </div>
          <div class="inspection__legend surface-reveal">
            <div><span>01</span><strong>Se</strong><small>Inspektionslys</small></div>
            <div><span>02</span><strong>Korrigér</strong><small>Polering efter behov</small></div>
            <div><span>03</span><strong>Beskyt</strong><small>Coating / forsegling</small></div>
          </div>
        </div>
      </section>

      <section class="proof" id="resultater" aria-labelledby="proof-title">
        <div class="surface-shell proof__grid">
          <div class="proof__copy surface-reveal">
            <p class="surface-eyebrow">Dokumentation</p>
            <h2 id="proof-title">Før.<br /><em>Efter.</em></h2>
            <p>Samme projekt. Samme ramme. Skift mellem projekterne med pilene og træk divideren for at kontrollere resultatet selv.</p>
            <div class="proof__rule"><i></i><span>NO FILTER / SAME ANGLE / REAL WORK</span></div>
          </div>
          <div class="proof__viewer surface-reveal"><BeforeAfterGallery /></div>
        </div>
      </section>

      <section class="process-line" aria-labelledby="process-title">
        <div class="surface-shell">
          <header class="process-line__head surface-reveal">
            <p class="surface-eyebrow">Processen</p>
            <h2 id="process-title">Roligt forløb.<br /><em>Kontrolleret resultat.</em></h2>
          </header>
          <div class="process-line__steps">
            <article class="process-node surface-reveal"><span>01</span><div><small>KONTAKT</small><h3>Fortæl om bilen</h3><p>Model, stand og det du gerne vil have forbedret.</p></div></article>
            <article class="process-node surface-reveal"><span>02</span><div><small>VURDERING</small><h3>Vi vælger niveauet</h3><p>Behandlingen tilpasses overfladerne og bilens faktiske behov.</p></div></article>
            <article class="process-node surface-reveal"><span>03</span><div><small>BEHANDLING</small><h3>Detaljen udføres</h3><p>Vask, rens, polering, beskyttelse eller kombinationen der giver mening.</p></div></article>
            <article class="process-node surface-reveal"><span>04</span><div><small>AFLEVERING</small><h3>Finishen kontrolleres</h3><p>Det samlede resultat vurderes, før bilen er klar.</p></div></article>
          </div>
        </div>
      </section>

      <section class="identity" aria-labelledby="identity-title">
        <div class="identity__type" aria-hidden="true">ESBJERG</div>
        <div class="surface-shell identity__grid">
          <div class="identity__copy surface-reveal">
            <p class="surface-eyebrow">Esbjerg Shine</p>
            <h2 id="identity-title">Lokalt arbejde.<br /><em>Høj finish.</em></h2>
            <p>Esbjerg Shine arbejder efter aftale fra Randersvej i Esbjerg. Det giver plads til at tilpasse behandlingen til bilen frem for at presse bilen ind i en standardpakke.</p>
          </div>
          <dl class="identity__facts surface-reveal">
            <div><dt>Adresse</dt><dd><a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{company.address.street}<br />{company.address.postalCode} {company.address.city} ↗</a></dd></div>
            <div><dt>Åbning</dt><dd>{company.openingText}</dd></div>
            <div><dt>Telefon</dt><dd><a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></dd></div>
            <div><dt>CVR</dt><dd>{company.cvr}</dd></div>
          </dl>
        </div>
      </section>

      <section class="surface-contact" id="kontakt" aria-labelledby="contact-title">
        <div class="surface-shell surface-contact__grid">
          <div class="surface-contact__intro surface-reveal">
            <p class="surface-eyebrow">Kontakt</p>
            <h2 id="contact-title">Din bil.<br /><em>Dit niveau.</em></h2>
            <p>Beskriv bilen og hvad du vil have gjort. Du behøver ikke vide, hvilken behandling der er den rigtige på forhånd.</p>
            <a class="surface-contact__phone" href={`tel:${company.phoneHref}`}><small>Ring direkte</small><strong>{company.phoneDisplay}</strong></a>
            <div class="surface-contact__social"><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={company.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a></div>
          </div>
          <div class="surface-form surface-reveal" data-surface-form>
            <div class="surface-form__top"><span>REQUEST / ESBJERG SHINE</span><i>01</i></div>
            <ContactForm />
          </div>
        </div>
      </section>
    </main>

    <footer class="surface-footer">
      <div class="surface-shell surface-footer__inner">
        <a class="surface-brand" href="#top"><span class="surface-brand__badge">ES</span><span><strong>ESBJERG SHINE</strong><small>DETALJER DER SKINNER.</small></span></a>
        <p>{company.address.street}, {company.address.postalCode} {company.address.city} · CVR {company.cvr}</p>
        <div><a href="/privatliv/">Privatliv</a><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={company.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></div>
      </div>
    </footer>

    <div class="finish-transition" data-finish-transition aria-hidden="true"><span></span><i></i><b></b></div>
  </div>
  <script is:inline src="/surface-editorial.js" defer></script>
</BaseLayout>
