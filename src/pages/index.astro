---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import ContactForm from '../components/ContactForm.astro';
import { company } from '../data/company';
import { services } from '../data/services';
import '../styles/auxo-refined.css';

const title = 'Bilpleje i Esbjerg | Esbjerg Shine';
const description = 'Esbjerg Shine tilbyder bilpleje, klargøring, polering, håndvask og lakbeskyttelse i Esbjerg. Kontakt os og få et tilbud tilpasset din bil.';

const serviceSchema = {
  '@type': 'ItemList',
  name: 'Bilpleje hos Esbjerg Shine',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      url: new URL(`/ydelser/${service.slug}/`, Astro.site ?? 'https://esbjergshine.dk').toString(),
      provider: { '@id': `${(Astro.site ?? new URL('https://esbjergshine.dk')).toString().replace(/\/$/, '')}/#virksomhed` }
    }
  }))
};
---
<BaseLayout title={title} description={description} schema={serviceSchema}>
  <div class="refined-site" id="top" data-refined-site>
    <div class="refined-topbar">
      <div class="refined-shell refined-topbar__inner">
        <span>{company.address.street}, {company.address.postalCode} {company.address.city}</span>
        <div><span>{company.openingText}</span><a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></div>
      </div>
    </div>

    <header class="refined-header" data-refined-header>
      <div class="refined-shell refined-header__inner">
        <a class="refined-brand" href="#top" aria-label="Esbjerg Shine – forside">
          <span class="refined-brand__mark">ES</span>
          <span><strong>ESBJERG SHINE</strong><small>DETALJER DER SKINNER.</small></span>
        </a>
        <nav class="refined-nav" aria-label="Primær navigation">
          <a href="#ydelser">Ydelser</a>
          <a href="#om">Om os</a>
          <a href="#resultater">Før / efter</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
        <a class="refined-header__cta" href="#kontakt">Få et tilbud <span>↗</span></a>
      </div>
    </header>

    <main id="indhold">
      <section class="refined-hero" aria-labelledby="hero-title">
        <div class="refined-hero__backdrop" aria-hidden="true"></div>
        <div class="refined-shell refined-hero__grid">
          <div class="refined-hero__copy refined-reveal">
            <p class="refined-kicker">BILPLEJE I ESBJERG</p>
            <h1 id="hero-title">Din bil fortjener<br /><span>det sidste finish.</span></h1>
            <p>Professionel håndvask, klargøring, polering og lakbeskyttelse med fokus på detaljerne, materialerne og et resultat der holder.</p>
            <div class="refined-hero__actions">
              <a class="refined-button refined-button--primary" href="#ydelser">Se vores ydelser <span>↓</span></a>
              <a class="refined-button refined-button--ghost" href={`tel:${company.phoneHref}`}>Ring {company.phoneDisplay} <span>↗</span></a>
            </div>
            <div class="refined-hero__meta">
              <div><small>Adresse</small><strong>{company.address.street}</strong></div>
              <div><small>Åbning</small><strong>Efter aftale</strong></div>
              <div><small>Område</small><strong>Esbjerg</strong></div>
            </div>
          </div>

          <div class="refined-hero__visual refined-reveal" data-hero-visual>
            <div class="refined-hero__frame">
              <div class="refined-hero__light" aria-hidden="true"></div>
              <img src="/hero-detailing-car.svg" width="1200" height="720" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
              <div class="refined-hero__glass" aria-hidden="true"></div>
              <div class="refined-hero__badge"><small>ESBJERG SHINE</small><strong>Detailing · Finish · Care</strong></div>
            </div>
          </div>
        </div>
      </section>

      <section class="refined-strip" aria-label="Esbjerg Shine nøglepunkter">
        <div class="refined-shell refined-strip__grid">
          <div><span>01</span><strong>Bilpleje efter aftale</strong><small>Ro til den enkelte bil</small></div>
          <div><span>02</span><strong>Lokalt i Esbjerg</strong><small>Randersvej 26, 6700</small></div>
          <div><span>03</span><strong>Detaljen i centrum</strong><small>Lak, kabine og finish</small></div>
        </div>
      </section>

      <section class="refined-services" id="ydelser" aria-labelledby="services-title">
        <div class="refined-shell">
          <header class="refined-section-head refined-reveal">
            <div><p class="refined-kicker">VORES YDELSER</p><h2 id="services-title">Bilpleje tilpasset<br />din bil.</h2></div>
            <p>Fra en grundig håndvask til polering, coating og komplet klargøring. Vi vurderer bilen og finder det niveau, der giver mening.</p>
          </header>

          <div class="refined-service-grid">
            {services.map((service, index) => (
              <article class={`refined-service-card refined-service-card--${service.slug} refined-reveal`} data-service-card>
                <a href={`/ydelser/${service.slug}/`} data-wiper-link data-service-name={service.title}>
                  <div class="refined-service-card__media" aria-hidden="true">
                    <span class="refined-service-card__wash"></span>
                    <span class="refined-service-card__shine"></span>
                    <i>0{index + 1}</i>
                  </div>
                  <div class="refined-service-card__body">
                    <small>{service.eyebrow}</small>
                    <h3>{service.title}</h3>
                    <p>{service.summary}</p>
                    <span class="refined-service-card__link">Læs mere <b>↗</b></span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="refined-about" id="om" aria-labelledby="about-title">
        <div class="refined-shell refined-about__grid">
          <div class="refined-about__media refined-reveal" data-about-media>
            <div class="refined-about__media-inner">
              <img src="/hero-detailing-car.svg" width="1200" height="720" alt="" aria-hidden="true" decoding="async" />
              <span class="refined-about__sweep" aria-hidden="true"></span>
              <div class="refined-about__label"><small>DETAILING STUDIO</small><strong>Esbjerg / 6700</strong></div>
            </div>
          </div>
          <div class="refined-about__copy refined-reveal">
            <p class="refined-kicker">OM ESBJERG SHINE</p>
            <h2 id="about-title">Bilpleje med fokus<br />på det, man kan se.</h2>
            <p>Esbjerg Shine arbejder med vask, rengøring, polering og beskyttelse af bilen. Målet er ikke at presse alle biler ind i den samme pakke, men at vælge den behandling der passer til bilens stand og det resultat, du ønsker.</p>
            <p>Arbejdet foregår efter aftale, så der er tid til at gennemgå bilen ordentligt og afslutte med fokus på helheden.</p>
            <div class="refined-about__facts">
              <div><small>Telefon</small><a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></div>
              <div><small>Adresse</small><a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{company.address.street}, {company.address.postalCode} {company.address.city} ↗</a></div>
              <div><small>CVR</small><span>{company.cvr}</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="refined-proof" id="resultater" aria-labelledby="proof-title">
        <div class="refined-shell">
          <header class="refined-section-head refined-section-head--center refined-reveal">
            <div><p class="refined-kicker">FØR & EFTER</p><h2 id="proof-title">Resultatet skal kunne ses.</h2></div>
            <p>Skift mellem projekterne med pilene, og træk divideren for at sammenligne før og efter.</p>
          </header>
          <div class="refined-proof__viewer refined-reveal"><BeforeAfterGallery /></div>
        </div>
      </section>

      <section class="refined-process" aria-labelledby="process-title">
        <div class="refined-shell">
          <header class="refined-section-head refined-reveal">
            <div><p class="refined-kicker">SÅDAN FOREGÅR DET</p><h2 id="process-title">En enkel vej<br />til en flottere bil.</h2></div>
            <p>Du behøver ikke kende den rigtige behandling på forhånd. Fortæl om bilen, så finder vi næste skridt sammen.</p>
          </header>
          <ol class="refined-process__steps">
            <li class="refined-reveal"><span>01</span><div><small>KONTAKT</small><strong>Fortæl om bilen</strong><p>Model, stand og hvad du gerne vil have forbedret.</p></div></li>
            <li class="refined-reveal"><span>02</span><div><small>VURDERING</small><strong>Vi finder løsningen</strong><p>Behandlingen tilpasses bilens aktuelle behov.</p></div></li>
            <li class="refined-reveal"><span>03</span><div><small>BEHANDLING</small><strong>Arbejdet udføres</strong><p>Vask, rens, polering eller beskyttelse med fokus på finish.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="refined-contact" id="kontakt" aria-labelledby="contact-title">
        <div class="refined-shell refined-contact__grid">
          <div class="refined-contact__copy refined-reveal">
            <p class="refined-kicker">KONTAKT</p>
            <h2 id="contact-title">Skal vi se på<br />din bil?</h2>
            <p>Send en kort besked med bilmodel, ønsket behandling og gerne hvad du vil have forbedret. Vi vender tilbage med næste skridt.</p>
            <a class="refined-contact__phone" href={`tel:${company.phoneHref}`}><small>Ring direkte</small><strong>{company.phoneDisplay}</strong></a>
            <div class="refined-contact__links"><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={company.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a></div>
          </div>
          <div class="refined-form refined-reveal">
            <div class="refined-form__title"><span>Få et uforpligtende tilbud</span><small>Vi svarer så hurtigt som muligt</small></div>
            <ContactForm />
          </div>
        </div>
      </section>
    </main>

    <footer class="refined-footer">
      <div class="refined-shell refined-footer__top">
        <a class="refined-brand" href="#top"><span class="refined-brand__mark">ES</span><span><strong>ESBJERG SHINE</strong><small>DETALJER DER SKINNER.</small></span></a>
        <div class="refined-footer__nav"><a href="#ydelser">Ydelser</a><a href="#om">Om os</a><a href="#kontakt">Kontakt</a><a href="/privatliv/">Privatliv</a></div>
      </div>
      <div class="refined-shell refined-footer__bottom"><span>{company.address.street}, {company.address.postalCode} {company.address.city}</span><span>CVR {company.cvr}</span></div>
    </footer>

    <div class="wiper-transition" data-wiper-transition aria-hidden="true">
      <canvas data-wiper-canvas></canvas>
      <div class="wiper-transition__label"><span data-wiper-label>BEHANDLING</span><i></i></div>
      <div class="wiper-arm" data-wiper-arm><i></i><b></b></div>
    </div>
  </div>
  <script is:inline src="/auxo-refined.js" defer></script>
</BaseLayout>
