---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import ContactForm from '../components/ContactForm.astro';
import { company } from '../data/company';
import { services } from '../data/services';
import '../styles/nordic-shine.css';

const title = 'Bilpleje i Esbjerg | Esbjerg Shine';
const description = 'Esbjerg Shine tilbyder håndvask, indvendig bilpleje, klargøring, polering og lakbeskyttelse i Esbjerg. Kontakt os for et tilbud tilpasset din bil.';

const serviceSchema = {
  '@type': 'ItemList',
  name: 'Bilpleje hos Esbjerg Shine',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      url: new URL(`/ydelser/${service.slug}/`, Astro.site ?? 'https://esbjergshine.dk').toString(),
      provider: { '@id': `${(Astro.site ?? new URL('https://esbjergshine.dk')).toString().replace(/\/$/, '')}/#virksomhed` }
    }
  }))
};
---
<BaseLayout title={title} description={description} schema={serviceSchema}>
  <div class="ns-site" id="top" data-ns-site>
    <div class="ns-topbar">
      <div class="ns-wrap ns-topbar__inner">
        <span>Bilpleje i Esbjerg · Efter aftale</span>
        <div>
          <a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{company.address.street}, {company.address.postalCode} {company.address.city}</a>
          <a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a>
        </div>
      </div>
    </div>

    <header class="ns-header" data-ns-header>
      <div class="ns-wrap ns-header__inner">
        <a class="ns-brand" href="#top" aria-label="Esbjerg Shine – forside">
          <span class="ns-brand__mark">ES</span>
          <span class="ns-brand__text"><strong>ESBJERG SHINE</strong><small>Detaljer der skinner.</small></span>
        </a>
        <nav class="ns-nav" aria-label="Primær navigation">
          <a href="#ydelser">Ydelser</a>
          <a href="#resultater">Før / efter</a>
          <a href="#om">Om os</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
        <a class="ns-header__cta" href="#kontakt">Få et tilbud</a>
      </div>
    </header>

    <main id="indhold">
      <section class="ns-hero" aria-labelledby="ns-hero-title">
        <div class="ns-wrap ns-hero__grid">
          <div class="ns-hero__copy ns-reveal">
            <p class="ns-eyebrow">LOKAL BILPLEJE · ESBJERG</p>
            <h1 id="ns-hero-title">En renere bil.<br /><span>En skarpere finish.</span></h1>
            <p class="ns-hero__lead">Håndvask, kabinepleje, polering og beskyttelse udført med fokus på detaljen — uden unødige pakker og salgstricks.</p>
            <div class="ns-actions">
              <a class="ns-button ns-button--primary" href="#ydelser">Se ydelser <span>↓</span></a>
              <a class="ns-button ns-button--quiet" href={`tel:${company.phoneHref}`}>Ring {company.phoneDisplay}</a>
            </div>
            <div class="ns-hero__trust" aria-label="Nøgleoplysninger">
              <div><small>Adresse</small><strong>{company.address.street}</strong></div>
              <div><small>Åbning</small><strong>Efter aftale</strong></div>
              <div><small>Område</small><strong>Esbjerg</strong></div>
            </div>
          </div>

          <div class="ns-hero__media ns-reveal" aria-label="Plads til Esbjerg Shine projektbilleder">
            <div class="ns-photo ns-photo--hero">
              <div class="ns-photo__surface"><span>PROJEKTFOTO</span><small>Polering · lak · finish</small></div>
              <div class="ns-photo__note">01 / DETAIL</div>
            </div>
            <div class="ns-photo ns-photo--small">
              <div class="ns-photo__surface"><span>PROJEKTFOTO</span><small>Kabine · tekstil · pleje</small></div>
              <div class="ns-photo__note">02 / INTERIOR</div>
            </div>
            <p class="ns-hero__media-note">Rigtige billeder fra Esbjerg Shine erstatter disse flader, når projektmaterialet er klar.</p>
          </div>
        </div>
      </section>

      <section class="ns-trustline" aria-label="Hvorfor vælge Esbjerg Shine">
        <div class="ns-wrap ns-trustline__grid">
          <div><strong>Efter aftale</strong><span>Tid til den enkelte bil</span></div>
          <div><strong>Lokalt i Esbjerg</strong><span>Randersvej 26, 6700</span></div>
          <div><strong>Tilpasset behandling</strong><span>Efter stand og behov</span></div>
          <div><strong>Direkte kontakt</strong><span>{company.phoneDisplay}</span></div>
        </div>
      </section>

      <section class="ns-services" id="ydelser" aria-labelledby="ns-services-title">
        <div class="ns-wrap">
          <header class="ns-section-head ns-reveal">
            <div>
              <p class="ns-eyebrow">YDELSER</p>
              <h2 id="ns-services-title">Det bilen har brug for.<br /><span>Ikke mere end det.</span></h2>
            </div>
            <p>Vi starter med bilen og det resultat, du ønsker. Behandlingen vælges derefter — ikke omvendt.</p>
          </header>

          <div class="ns-service-grid">
            {services.map((service, index) => (
              <article class={`ns-service ns-service--${service.slug} ns-reveal`}>
                <a href={`/ydelser/${service.slug}/`} data-wiper-link data-service-name={service.title}>
                  <div class="ns-service__media" aria-hidden="true">
                    <div class="ns-service__texture"></div>
                    <span>0{index + 1}</span>
                  </div>
                  <div class="ns-service__body">
                    <small>{service.eyebrow}</small>
                    <h3>{service.title}</h3>
                    <p>{service.summary}</p>
                    <span class="ns-service__link">Se ydelsen <b>↗</b></span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ns-values" aria-labelledby="ns-values-title">
        <div class="ns-wrap ns-values__grid">
          <div class="ns-values__intro ns-reveal">
            <p class="ns-eyebrow">VORES TILGANG</p>
            <h2 id="ns-values-title">God bilpleje behøver ikke være kompliceret.</h2>
          </div>
          <div class="ns-values__items">
            <article class="ns-reveal"><span>01</span><h3>Vi ser på bilen først</h3><p>Stand, materialer og forventninger afgør behandlingen.</p></article>
            <article class="ns-reveal"><span>02</span><h3>Du ved, hvad der skal ske</h3><p>Klar dialog før arbejdet går i gang.</p></article>
            <article class="ns-reveal"><span>03</span><h3>Finishen tæller</h3><p>Detaljerne bliver gennemgået, før bilen er klar.</p></article>
          </div>
        </div>
      </section>

      <section class="ns-proof" id="resultater" aria-labelledby="ns-proof-title">
        <div class="ns-wrap">
          <header class="ns-section-head ns-section-head--compact ns-reveal">
            <div>
              <p class="ns-eyebrow">FØR / EFTER</p>
              <h2 id="ns-proof-title">Se forskellen selv.</h2>
            </div>
            <p>Skift mellem projekterne med pilene og træk divideren for at sammenligne før og efter.</p>
          </header>
          <div class="ns-proof__viewer ns-reveal"><BeforeAfterGallery /></div>
        </div>
      </section>

      <section class="ns-about" id="om" aria-labelledby="ns-about-title">
        <div class="ns-wrap ns-about__grid">
          <div class="ns-about__media ns-reveal" aria-hidden="true">
            <div class="ns-about__photo"><span>ESBJERG SHINE</span><small>Randersvej 26 · 6700 Esbjerg</small></div>
          </div>
          <div class="ns-about__copy ns-reveal">
            <p class="ns-eyebrow">LOKALT I ESBJERG</p>
            <h2 id="ns-about-title">Personlig bilpleje.<br />Uden samlebånd.</h2>
            <p>Esbjerg Shine arbejder efter aftale. Det giver mulighed for at se bilen ordentligt igennem og tilpasse arbejdet til dens faktiske stand.</p>
            <p>Du behøver ikke vide, om bilen skal have polering, coating eller en komplet klargøring på forhånd. Beskriv bilen og ønsket — så tager vi den derfra.</p>
            <dl class="ns-about__facts">
              <div><dt>Telefon</dt><dd><a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></dd></div>
              <div><dt>Adresse</dt><dd><a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{company.address.street}, {company.address.postalCode} {company.address.city} ↗</a></dd></div>
              <div><dt>CVR</dt><dd>{company.cvr}</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="ns-process" aria-labelledby="ns-process-title">
        <div class="ns-wrap">
          <header class="ns-section-head ns-section-head--compact ns-reveal">
            <div><p class="ns-eyebrow">SÅDAN FOREGÅR DET</p><h2 id="ns-process-title">Fra besked til færdig bil.</h2></div>
            <p>En enkel proces, så du ved hvad næste skridt er.</p>
          </header>
          <ol class="ns-process__grid">
            <li class="ns-reveal"><span>01</span><strong>Fortæl om bilen</strong><p>Model, stand og hvad du gerne vil have forbedret.</p></li>
            <li class="ns-reveal"><span>02</span><strong>Vi vurderer behovet</strong><p>Vi finder den behandling, der passer til bilen.</p></li>
            <li class="ns-reveal"><span>03</span><strong>Vi laver arbejdet</strong><p>Du får besked, når bilen er klar til afhentning.</p></li>
          </ol>
        </div>
      </section>

      <section class="ns-contact" id="kontakt" aria-labelledby="ns-contact-title">
        <div class="ns-wrap ns-contact__grid">
          <div class="ns-contact__copy ns-reveal">
            <p class="ns-eyebrow">KONTAKT</p>
            <h2 id="ns-contact-title">Fortæl kort om bilen.</h2>
            <p>Send bilmodel, hvad du ønsker hjælp til og gerne et par billeder, når vi følger op. Så kan vi bedre vurdere næste skridt.</p>
            <a class="ns-contact__phone" href={`tel:${company.phoneHref}`}><small>Ring direkte</small><strong>{company.phoneDisplay}</strong></a>
            <div class="ns-contact__links"><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={company.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a></div>
          </div>
          <div class="ns-form ns-reveal">
            <div class="ns-form__head"><strong>Få et uforpligtende tilbud</strong><span>Vi vender tilbage hurtigst muligt.</span></div>
            <ContactForm />
          </div>
        </div>
      </section>
    </main>

    <footer class="ns-footer">
      <div class="ns-wrap ns-footer__main">
        <a class="ns-brand ns-brand--footer" href="#top"><span class="ns-brand__mark">ES</span><span class="ns-brand__text"><strong>ESBJERG SHINE</strong><small>Detaljer der skinner.</small></span></a>
        <div class="ns-footer__nav"><a href="#ydelser">Ydelser</a><a href="#resultater">Før / efter</a><a href="#om">Om os</a><a href="#kontakt">Kontakt</a><a href="/privatliv/">Privatliv</a></div>
      </div>
      <div class="ns-wrap ns-footer__bottom"><span>{company.address.street}, {company.address.postalCode} {company.address.city}</span><span>CVR {company.cvr}</span></div>
    </footer>

    <div class="ns-wiper" data-wiper-transition aria-hidden="true">
      <canvas data-wiper-canvas></canvas>
      <div class="ns-wiper__blade" data-wiper-arm><i></i></div>
    </div>
  </div>
  <script is:inline src="/nordic-shine.js" defer></script>
</BaseLayout>
