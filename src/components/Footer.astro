---
import { company } from '../data/company';
---
<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <a class="brand brand--footer" href="/" aria-label="Esbjerg Shine – forsiden">
        <span class="brand__logo brand__logo--footer" aria-hidden="true"></span>
      </a>
      <p class="site-footer__lead">Bilpleje i Esbjerg med fokus på finish, detaljer og klare aftaler.</p>
    </div>

    <div>
      <p class="footer-label">Kontakt</p>
      <a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a>
      <a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{company.address.street}, {company.address.postalCode} {company.address.city}</a>
      <span>{company.openingText}</span>
    </div>

    <div>
      <p class="footer-label">Følg med</p>
      <div class="footer-socials" aria-label="Esbjerg Shine på sociale medier">
        <a class="social-icon" href={company.facebook} target="_blank" rel="noopener noreferrer" aria-label="Esbjerg Shine på Facebook" title="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4.5c-.5-.1-1.8-.2-3.4-.2-3.3 0-5.6 2-5.6 5.8V13H4v4h4v7h5v-7h3.5l.6-4H13v-2.5C13 9.3 13.4 8 14 8Z"/></svg>
        </a>
        <a class="social-icon" href={company.instagram} target="_blank" rel="noopener noreferrer" aria-label="Esbjerg Shine på Instagram" title="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.7" cy="6.4" r="1" class="social-icon__dot"/></svg>
        </a>
      </div>
      <a class="footer-privacy" href="/privatliv/">Privatliv</a>
    </div>
  </div>

  <div class="shell site-footer__bottom">
    <span>© <span data-year></span> {company.name} · {company.entityType} · CVR {company.cvr}</span>
    <a href="#top">Til toppen ↑</a>
  </div>
</footer>
