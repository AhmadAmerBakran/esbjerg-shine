---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchPriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  fetchPriority = 'auto',
  width,
  height
} = Astro.props;

const publicFile = join(process.cwd(), 'public', src.replace(/^\//, ''));
const exists = existsSync(publicFile);
---
<div class:list={['media-slot', className]} data-media-slot>
  {exists && (
    <img
      src={src}
      alt={alt}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      width={width}
      height={height}
      data-media-image
    />
  )}
  <span class="media-slot__fallback" aria-hidden="true"></span>
</div>
