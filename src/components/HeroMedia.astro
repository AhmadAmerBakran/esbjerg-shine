---
import { siteMedia } from '../data/media';
---
<div class="hero-card hero-media" data-hero-media>
  <img
    class="hero-media__poster"
    src={siteMedia.hero.poster}
    alt=""
    width="1600"
    height="2000"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    data-media-image
    aria-hidden="true"
  />
  <video
    class="hero-media__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={siteMedia.hero.poster}
    data-hero-video
    aria-hidden="true"
  >
    <source src={siteMedia.hero.webm} type="video/webm" />
    <source src={siteMedia.hero.mp4} type="video/mp4" />
  </video>
  <span class="hero-card__logo hero-media__fallback-logo" aria-hidden="true"></span>
  <div class="hero-card__meta"><span>ESBJERG · 6700</span><small>Detaljer der skinner.</small></div>
</div>
