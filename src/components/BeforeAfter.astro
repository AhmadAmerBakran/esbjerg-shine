---
const comparisons = [
  { title: 'Lak & glans', before: 'MAT LAK', after: 'DYB GLANS' },
  { title: 'Kabine', before: 'FØR RENS', after: 'EFTER RENS' },
  { title: 'Fælge', before: 'BREMSestøv', after: 'REN FINISH' },
  { title: 'Komplet klargøring', before: 'ANKOMST', after: 'AFLEVERING' }
];
---
<div class="comparison-gallery" data-comparison-gallery>
  <div class="comparison-gallery__top">
    <div class="comparison-gallery__meta">
      <small>Aktuelt eksempel</small>
      <strong data-comparison-title>{comparisons[0].title}</strong>
    </div>
    <div class="comparison-gallery__nav" aria-label="Skift mellem før- og eftereksempler">
      <button type="button" aria-label="Forrige eksempel" data-comparison-prev>←</button>
      <button type="button" aria-label="Næste eksempel" data-comparison-next>→</button>
    </div>
  </div>

  <div class="comparison-gallery__stage" aria-live="polite">
    {comparisons.map((item, index) => (
      <article
        class:list={['comparison-set', { 'is-active': index === 0 }]}
        data-comparison-set
        data-title={item.title}
        aria-hidden={index === 0 ? 'false' : 'true'}
      >
        <div class="comparison" data-comparison>
          <div class="comparison__scene comparison__scene--after" aria-hidden="true">
            <span class="comparison-placeholder">
              <b>{item.after}</b>
              <strong>EFTER</strong>
              <small>Rigtigt projektfoto indsættes senere</small>
            </span>
          </div>
          <div class="comparison__scene comparison__scene--before" aria-hidden="true">
            <span class="comparison-placeholder">
              <b>{item.before}</b>
              <strong>FØR</strong>
              <small>Rigtigt projektfoto indsættes senere</small>
            </span>
          </div>
          <span class="comparison__label comparison__label--before" aria-hidden="true">FØR</span>
          <span class="comparison__label comparison__label--after" aria-hidden="true">EFTER</span>
          <div class="comparison__divider" aria-hidden="true"><span>↔</span></div>
          <input
            class="comparison__range"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label={`Sammenlign før og efter for ${item.title}`}
            data-comparison-range
            tabindex={index === 0 ? 0 : -1}
          />
        </div>
      </article>
    ))}
  </div>

  <div class="comparison-gallery__bottom">
    <div class="comparison-gallery__dots" aria-label="Vælg før- og eftereksempel">
      {comparisons.map((item, index) => (
        <button
          class:list={['comparison-gallery__dot', { 'is-active': index === 0 }]}
          type="button"
          aria-label={`Vis ${item.title}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-comparison-dot
          data-index={index}
        ></button>
      ))}
    </div>
    <span class="comparison-gallery__counter" data-comparison-counter>01 / 04</span>
  </div>
</div>
