{
  "name": "esbjerg-shine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cf:dev": "npm run build && wrangler dev --local",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:deploy": "wrangler deploy",
    "cf:rollback": "wrangler rollback",
    "lint": "eslint \"public/*.js\" \"functions/**/*.js\" \"worker/**/*.js\" \"astro.config.mjs\" \"eslint.config.js\"",
    "format": "prettier --write \"src/data/*.ts\" \"src/pages/*.ts\" \"public/*.js\" \"functions/**/*.js\" \"worker/**/*.js\" \"astro.config.mjs\" \"wrangler.jsonc\" \"eslint.config.js\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/data/*.ts\" \"src/pages/*.ts\" \"public/*.js\" \"functions/**/*.js\" \"worker/**/*.js\" \"astro.config.mjs\" \"wrangler.jsonc\" \"eslint.config.js\" \".prettierrc.json\"",
    "quality": "npm run check && npm run lint && npm run format:check && npm audit --audit-level=low && npm run build && npm run cf:dry-run"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.141.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260925.1": true
  }
}
