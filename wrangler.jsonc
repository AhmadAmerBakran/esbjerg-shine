{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esbjerg-shine",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "esbjergshine.dk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "production"
  }
}
